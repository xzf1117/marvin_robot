<mujoco model="marvin_scene">
  
  <!-- ================== 全局配置 ================== -->
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <!-- ================== 资源 ================== -->
  <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="160" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

        <body name="left_tool_target" pos="0.5 0.2 .9" mocap="true">
      <geom type="box" size=".04 .04 .04" contype="0" conaffinity="0" rgba=".6 .3 .3 .2"/>
      <site name = "left_target" type="sphere" size="0.01" rgba="0 0 1 1" group="1"/>
    </body>
    <body name="right_tool_target" pos="0.5 -0.2 .9" mocap="true">
      <geom type="box" size=".04 .04 .04" contype="0" conaffinity="0" rgba=".6 .3 .3 .2"/>
      <site name = "right_target" type="sphere" size="0.01" rgba="0 0 1 1" group="1"/>
    </body>
    </worldbody>

    <!-- ===== 机器人 ===== -->
  <include file="marvin_pro_mink.xml"/>


</mujoco>
