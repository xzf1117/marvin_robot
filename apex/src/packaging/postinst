#!/bin/bash
set -e

PROFILE_SCRIPT="/etc/profile.d/kernelmind_apex.sh"
INSTALL_PREFIX="/opt/kernelmind/apex/install"

cat > "${PROFILE_SCRIPT}" <<'EOF'
# KernelMind Apex — ROS 2 environment
source /opt/kernelmind/apex/install/setup.bash
EOF

chmod 644 "${PROFILE_SCRIPT}"

# Create config symlinks
mkdir -p /etc/kernelmind/marvin_ros_control
ln -sfn "${INSTALL_PREFIX}/marvin_ros_control/share/marvin_ros_control/config" \
    /etc/kernelmind/marvin_ros_control/config

mkdir -p /etc/kernelmind/marvin_teleop
ln -sfn "${INSTALL_PREFIX}/marvin_teleop/share/marvin_teleop/config" \
    /etc/kernelmind/marvin_teleop/config

echo "KernelMind Apex installed. Re-login or run:"
echo "  source /etc/profile.d/kernelmind_apex.sh"
